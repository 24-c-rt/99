              "newString": "  <script>\n    (function () {\n      const progressFill = document.getElementById('progress-fill');\n      const readStatus = document.getElementById('read-status');\n      const quizLock = document.getElementById('quiz-lock');\n      const fieldset = document.getElementById('quiz-fieldset');\n      const form = document.getElementById('quiz-form');\n      const result = document.getElementById('result');\n      const resetBtn = document.getElementById('reset-btn');\n      const readCount = document.getElementById('read-count');\n\n      const DWELL_SECONDS = 8;\n      const sectionIds = ['s1', 's2', 's3', 's4'];\n      const sectionState = {};\n      sectionIds.forEach(function (id) {\n        sectionState[id] = { inView: false, elapsed: 0, lastTick: null, dwellDone: false, confirmed: false };\n      });\n\n      const answers = {\n        q1: 'c',\n        q2: 'c',\n        q3: 'b',\n        q4: 'c',\n        q5: 'd'\n      };\n\n      const explanations = {\n        q1: '5 項危險因子中，符合 3 項（含）以上即代表有代謝症候群。',\n        q2: '30 歲以上民眾可使用國民健康署提供的成人預防保健服務，每 5 年 1 次免費。',\n        q3: '「我的餐盤」6 口訣包含：菜比水果多一點；另有每餐水果拳頭大、豆魚蛋肉一掌心、堅果種子一茶匙等。',\n        q4: '建議每週累積 150 分鐘以上中度身體活動，可分段進行。',\n        q5: '代謝症候群 5 項危險因子為血壓偏高、血糖偏高、血脂偏高、腰圍過粗、好膽固醇不足；身高過低不在其中。'\n      };\n\n      function updateProgress() {\n        const scrollTop = window.scrollY || document.documentElement.scrollTop;\n        const height = document.documentElement.scrollHeight - window.innerHeight;\n        const pct = height > 0 ? Math.min(100, Math.max(0, (scrollTop / height) * 100)) : 0;\n        progressFill.style.width = pct + '%';\n      }\n\n      function completedCount() {\n        return sectionIds.filter(function (id) { return sectionState[id].confirmed; }).length;\n      }\n\n      function updateReadStatus() {\n        const done = completedCount();\n        readCount.textContent = String(done);\n        sectionIds.forEach(function (id) {\n          const li = document.querySelect